# --- App URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001

# --- Firebase web config (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Firebase App Check (reCAPTCHA Enterprise site key); App Check stays off while empty
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Firebase Admin (server only): either the three vars or the full JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Stripe (server only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs per plan. Monthly falls back to PRICE_PRO / PRICE_PRO_PLUS / PRICE_PRO_PLUS_PLUS
PRICE_PRO_MONTHLY=
PRICE_PRO_YEARLY=
PRICE_PORTFOLIO_MONTHLY=
PRICE_PORTFOLIO_YEARLY=
PRICE_AGENCY_MONTHLY=
PRICE_AGENCY_YEARLY=
PRICE_PRO=
PRICE_PRO_PLUS=
PRICE_PRO_PLUS_PLUS=

# --- Firma (server only). Company key; per-business workspace keys live in integrations_firma
FIRMA_API_KEY=
# Company-level fallback template when a business has no template (FIRMA_DEFAULT_TEMPLATE_ID takes precedence)
FIRMA_DEFAULT_TEMPLATE_ID=
FIRMA_TEMPLATE_ID=

# --- Mapbox (public; restrict by URL in the Mapbox dashboard)
NEXT_PUBLIC_MAPBOX_API_KEY=

# --- PDF engine: leave empty for Chromium, or "react" for React-PDF
PDF_ENGINE=

# --- Upstash Redis for per-user rate limiting; rate limiting stays off while empty
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
