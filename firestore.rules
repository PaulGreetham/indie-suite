rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() { return request.auth != null; }
    // Live plan mirrored by the Stripe webhook into server-only billing/{uid}; a missing doc denies
    function hasActivePlan() {
      return get(/databases/$(database)/documents/billing/$(request.auth.uid)).data.status in ['active', 'trialing', 'past_due'];
    }

    // Server-only: Firma workspace IDs and API keys, written by the Admin SDK (bypasses rules)
    match /integrations_firma/{businessId} {
      allow read, write: if false;
    }

    // Server-only: Stripe customer and subscription state per uid, written by the Admin SDK
    match /billing/{uid} {
      allow read, write: if false;
    }

    // Server-only: processed Stripe webhook event ids
    match /stripe_events/{eventId} {
      allow read, write: if false;
    }

    match /{collection}/{doc} {
      allow create: if isAuthed() && hasActivePlan() && (
        ( collection in ['customers','venues','events','invoices','receipts','settings_bank_accounts']
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.businessId is string )
        || ( collection in ['settings_trading_details']
          && request.resource.data.ownerId == request.auth.uid ) );
      allow read, delete: if isAuthed() && hasActivePlan()
        && !(collection in ['integrations_firma', 'billing', 'stripe_events'])
        && resource.data.ownerId == request.auth.uid;
      // Contracts are written only by the server, so Firma ids and recipients can't be rewritten (R-11)
      allow update: if isAuthed() && hasActivePlan()
        && !(collection in ['integrations_firma', 'billing', 'stripe_events', 'contracts'])
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
