rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in with a verified email (R-01d)
    function isAuthed() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // Live plan mirrored by the Stripe webhook into server-only billing/{uid}; a missing doc denies
    function hasActivePlan() {
      return get(/databases/$(database)/documents/billing/$(request.auth.uid)).data.status in ['active', 'trialing', 'past_due'];
    }
    function canAccess() {
      return isAuthed() && hasActivePlan();
    }
    function isOwner() {
      return resource.data.ownerId == request.auth.uid;
    }
    // The referenced business exists and belongs to the caller (R-01b, R-13)
    function ownsBusiness(businessId) {
      return businessId is string
        && exists(/databases/$(database)/documents/settings_trading_details/$(businessId))
        && get(/databases/$(database)/documents/settings_trading_details/$(businessId)).data.ownerId == request.auth.uid;
    }
    // New docs are owned by the caller, belong to one of the caller's businesses and are stamped by the server
    function validNewOwnedDoc() {
      return request.resource.data.ownerId == request.auth.uid
        && ownsBusiness(request.resource.data.businessId)
        && request.resource.data.createdAt == request.time;
    }
    // Updates may only touch the listed fields, so ownerId, businessId and createdAt are immutable (R-01a)
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function optString(data, field, max) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= max);
    }
    function reqString(data, field, max) {
      return field in data && data[field] is string && data[field].size() > 0 && data[field].size() <= max;
    }
    function optAddress(data) {
      return !('address' in data) || data.address == null || (
        data.address is map
        && data.address.keys().hasOnly(['building', 'street', 'city', 'area', 'postcode', 'country'])
        && optString(data.address, 'building', 200)
        && optString(data.address, 'street', 200)
        && optString(data.address, 'city', 200)
        && optString(data.address, 'area', 200)
        && optString(data.address, 'postcode', 50)
        && optString(data.address, 'country', 100)
      );
    }

    // Server-only: Firma workspace IDs and API keys, written by the Admin SDK (bypasses rules)
    match /integrations_firma/{businessId} {
      allow read, write: if false;
    }

    // Server-only: Stripe customer and subscription state per uid, written by the Admin SDK
    match /billing/{uid} {
      allow read, write: if false;
    }

    // Server-only: processed Stripe webhook event ids
    match /stripe_events/{eventId} {
      allow read, write: if false;
    }

    // Businesses are created via POST /api/businesses, which enforces the plan limit
    match /settings_trading_details/{id} {
      function validBusiness(data) {
        return reqString(data, 'name', 200)
          && optString(data, 'contactName', 200)
          && optString(data, 'contactEmail', 200)
          && optString(data, 'phone', 50)
          && optString(data, 'building', 200)
          && optString(data, 'street', 200)
          && optString(data, 'city', 200)
          && optString(data, 'area', 200)
          && optString(data, 'postcode', 50)
          && optString(data, 'country', 100)
          && (!('emails' in data) || data.emails == null || (data.emails is list && data.emails.size() <= 10));
      }
      // Deleted via DELETE /api/businesses/[id], which removes its records and blocks if invoices exist
      allow read: if canAccess() && isOwner();
      allow update: if canAccess() && isOwner()
        && onlyChanges(['name', 'contactName', 'contactEmail', 'emails', 'phone', 'building', 'street', 'city', 'area', 'postcode', 'country'])
        && validBusiness(request.resource.data);
    }

    match /settings_bank_accounts/{id} {
      function validBankAccount(data) {
        return reqString(data, 'name', 200)
          && optString(data, 'bankName', 200)
          && optString(data, 'accountHolder', 200)
          && optString(data, 'accountNumberOrIban', 64)
          && optString(data, 'sortCodeOrBic', 32)
          && optString(data, 'currency', 10)
          && optString(data, 'notes', 2000);
      }
      allow read, delete: if canAccess() && isOwner();
      allow create: if canAccess() && validNewOwnedDoc()
        && request.resource.data.keys().hasOnly(['name', 'bankName', 'accountHolder', 'accountNumberOrIban', 'sortCodeOrBic', 'currency', 'notes', 'createdAt', 'ownerId', 'businessId'])
        && validBankAccount(request.resource.data);
      allow update: if canAccess() && isOwner()
        && onlyChanges(['name', 'bankName', 'accountHolder', 'accountNumberOrIban', 'sortCodeOrBic', 'currency', 'notes'])
        && validBankAccount(request.resource.data);
    }

    match /customers/{id} {
      function validCustomer(data) {
        return reqString(data, 'fullName', 200)
          && optString(data, 'fullNameLower', 200)
          && optString(data, 'company', 200)
          && optString(data, 'email', 200)
          && optString(data, 'phone', 50)
          && optString(data, 'website', 300)
          && optString(data, 'notes', 5000)
          && optAddress(data)
          && (!('preferredContact' in data) || data.preferredContact == null || data.preferredContact in ['email', 'phone', 'other']);
      }
      allow read, delete: if canAccess() && isOwner();
      allow create: if canAccess() && validNewOwnedDoc()
        && request.resource.data.keys().hasOnly(['fullName', 'fullNameLower', 'company', 'email', 'phone', 'website', 'address', 'preferredContact', 'notes', 'createdAt', 'eventsLinked', 'totalValue', 'ownerId', 'businessId'])
        && request.resource.data.get('eventsLinked', 0) == 0
        && request.resource.data.get('totalValue', 0) == 0
        && validCustomer(request.resource.data);
      allow update: if canAccess() && isOwner()
        && onlyChanges(['fullName', 'fullNameLower', 'company', 'email', 'phone', 'website', 'address', 'preferredContact', 'notes'])
        && validCustomer(request.resource.data);
    }

    match /venues/{id} {
      function validVenue(data) {
        return reqString(data, 'name', 200)
          && optString(data, 'nameLower', 200)
          && optString(data, 'phone', 50)
          && optString(data, 'website', 300)
          && optString(data, 'notes', 5000)
          && optAddress(data);
      }
      allow read, delete: if canAccess() && isOwner();
      allow create: if canAccess() && validNewOwnedDoc()
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'phone', 'website', 'address', 'notes', 'createdAt', 'eventsLinked', 'totalValue', 'ownerId', 'businessId'])
        && request.resource.data.get('eventsLinked', 0) == 0
        && request.resource.data.get('totalValue', 0) == 0
        && validVenue(request.resource.data);
      allow update: if canAccess() && isOwner()
        && onlyChanges(['name', 'nameLower', 'phone', 'website', 'address', 'notes'])
        && validVenue(request.resource.data);
    }

    // A referenced doc exists in the collection and belongs to the caller (S-01)
    function ownsDoc(coll, id) {
      return id is string
        && exists(/databases/$(database)/documents/$(coll)/$(id))
        && get(/databases/$(database)/documents/$(coll)/$(id)).data.ownerId == request.auth.uid;
    }
    // Optional reference: absent/null, unchanged on update, or pointing at one of the caller's docs
    function optOwnedRef(coll, field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (resource != null && field in resource.data && request.resource.data[field] == resource.data[field])
        || ownsDoc(coll, request.resource.data[field]);
    }

    match /events/{id} {
      function validEvent(data) {
        return reqString(data, 'title', 200)
          && reqString(data, 'startsAt', 40)
          && optString(data, 'endsAt', 40)
          && optString(data, 'notes', 5000);
      }
      allow read, delete: if canAccess() && isOwner();
      allow create: if canAccess() && validNewOwnedDoc()
        && request.resource.data.keys().hasOnly(['title', 'startsAt', 'endsAt', 'notes', 'customerId', 'venueId', 'createdAt', 'ownerId', 'businessId'])
        && validEvent(request.resource.data)
        && ownsDoc('customers', request.resource.data.customerId)
        && ownsDoc('venues', request.resource.data.venueId);
      allow update: if canAccess() && isOwner()
        && onlyChanges(['title', 'startsAt', 'endsAt', 'notes', 'customerId', 'venueId'])
        && validEvent(request.resource.data)
        && optOwnedRef('customers', 'customerId')
        && optOwnedRef('venues', 'venueId');
    }

    // Invoices are written by /api/invoices, which reserves unique numbers in a transaction and sets paidAt (R-14)
    match /invoices/{id} {
      allow read: if canAccess() && isOwner();
    }

    // Server-only: per-owner invoice number reservations
    match /invoice_numbers/{key} {
      allow read, write: if false;
    }

    // Contracts are created and updated only by the server, so Firma ids and recipients can't be rewritten (R-11)
    match /contracts/{id} {
      allow read, delete: if canAccess() && isOwner();
    }

    // Any collection without a match block above is denied by default
  }
}
